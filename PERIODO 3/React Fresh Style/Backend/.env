# variable de entorno del backend
# el archivo .env nunca debe subirse a un repositorio publico
# por que contiene datos sensibles

# puerto donde va a correr el servidor Express
PORT=3000

# datos conexion a mysql (xampp por defecto localhost)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=FRESH_STYLE

# texto secreto usado para firmar los token jwt de sesion
# cambiarlo por cualquier cadena larga y unica en su proyecto
JWT_SECRET=clave_secreta_proyecto_fresh_style_2026
JWT_EXPIRES_IN=8h

# Datos del usuario administrador (basados en los registros del script SQL)
SEED_ADMIN_NOMBRE=admin_elite
SEED_ADMIN_EMAIL=admin.elite@freshstyle.com
SEED_ADMIN_PASSWORD=Admin#2026